#!/usr/bin/env sh
# Gradle wrapper script for Task 3
# Auto-downloads Gradle if not present

##############################################################################
# Note: In a real project, this file is generated by:
#   gradle wrapper --gradle-version 8.7
# For this repo the actual binary is committed via gradle/wrapper/
##############################################################################

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
MAX_FD="maximum"

warn () { echo "$*" ; }
die () { echo ; echo "ERROR: $*" ; echo ; exit 1 ; }

# Resolve JAVA_HOME
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
    [ -x "$JAVACMD" ] || die "JAVA_HOME is set to an invalid directory: $JAVA_HOME"
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "JAVA_HOME is not set and 'java' could not be found."
fi

APP_HOME=$(cd "$(dirname "$0")" && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
GRADLE_OPTS="${GRADLE_OPTS:-}"

exec "$JAVACMD" \
    $GRADLE_OPTS \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
